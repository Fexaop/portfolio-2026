---
import Script from "../components/Script.astro"
import Nav from "../components/Nav.astro"
import Css from "../components/Css.astro"
import Grid from "../components/Grid.astro"
import FerrofluidBg from "../components/FerrofluidBg.astro"

const { class: className, nav, isHome = false } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <!-- FIRST: detect blog→portfolio handoff before any paint -->
    <script is:inline>
      ;(function () {
        try {
          var fromBlog = false
          var p = new URLSearchParams(location.search)
          var q = p.get("xsite")
          if (q === "to-portfolio" || q === "from-blog") fromBlog = true
          if (
            !fromBlog &&
            /(?:^|;\s*)pwnhub_xsite=to-portfolio(?:;|$)/.test(document.cookie)
          ) {
            fromBlog = true
          }
          if (fromBlog) {
            document.documentElement.classList.add(
              "xsite-from-blog",
              "xsite-arrived",
            )
            // strip query ASAP so it doesn't linger
            if (q) {
              p.delete("xsite")
              var rest = p.toString()
              history.replaceState(
                null,
                "",
                location.pathname + (rest ? "?" + rest : "") + location.hash,
              )
            }
            // clear cookie so a refresh shows normal loader
            document.cookie =
              "pwnhub_xsite=; Domain=.pwnhub.in; Path=/; Max-Age=0; SameSite=Lax"
            document.cookie = "pwnhub_xsite=; Path=/; Max-Age=0; SameSite=Lax"
          }
        } catch (e) {}
      })()
    </script>
    <style is:inline>
      /* Short black handoff only — lifts via .xsite-ready within ~1s */
      html.xsite-from-blog body::before {
        content: "";
        position: fixed;
        inset: 0;
        z-index: 2147483645;
        background: #000;
        pointer-events: none;
        opacity: 1;
        transition: opacity 0.35s ease;
      }
      html.xsite-from-blog.xsite-ready body::before {
        opacity: 0;
        visibility: hidden;
      }
      html.xsite-from-blog [data-module="loader"],
      html.xsite-arrived [data-module="loader"],
      html.xsite-from-blog .site-loader,
      html.xsite-arrived .site-loader {
        display: none !important;
        visibility: hidden !important;
        opacity: 0 !important;
        pointer-events: none !important;
      }
    </style>
    <!-- Force-lift black veil quickly even if JS modules fail -->
    <script is:inline>
      ;(function () {
        if (!document.documentElement.classList.contains("xsite-from-blog"))
          return
        function lift() {
          document.documentElement.classList.add("xsite-ready")
          setTimeout(function () {
            document.documentElement.classList.remove(
              "xsite-from-blog",
              "xsite-arrived",
              "xsite-ready",
            )
          }, 400)
        }
        // Max ~0.9s black, then show portfolio
        setTimeout(lift, 900)
        document.addEventListener("DOMContentLoaded", function () {
          setTimeout(lift, 400)
        })
        window.addEventListener("load", function () {
          setTimeout(lift, 100)
        })
      })()
    </script>

    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon_svg.svg" />
    <meta name="generator" content={Astro.generator} />
    <Css />
    <title>FEXA — Gunit Kumar · Backend & DevOps Engineer</title>

    <meta name="viewport" content="width=device-width, user-scalable=no" />
    <meta
      name="description"
      content="FEXA — Gunit Kumar. Backend & DevOps engineer building reliable, scalable systems, platforms, and automated infrastructure. Open to roles & freelance."
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FEXA" />
    <meta
      property="og:title"
      content="FEXA — Gunit Kumar · Backend & DevOps Engineer"
    />
    <meta
      property="og:description"
      content="Backend & DevOps engineer building reliable, scalable systems and automated infrastructure."
    />
    <meta property="og:image" content="/og.png" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="FEXA — Gunit Kumar · Backend & DevOps Engineer"
    />
    <meta
      name="twitter:description"
      content="Backend & DevOps engineer building reliable, scalable systems and automated infrastructure."
    />
    <meta name="twitter:image" content="/og.png" />

    {!isHome && <link href="/code.css" rel="stylesheet" />}
  </head>
  <body>
    <FerrofluidBg />

    <Nav>
      {nav}
    </Nav>
    <main class="w-screen overflow-clip">
      <slot />
    </main>

    <Grid />

    <Script />

    <script is:inline src="/js/pacman-transition.js"></script>

    <script>
      ;(() => {
        console.log(
          "%c%s",
          "font-size:10px; color:#fff; background:#000; padding: 10px 10px; margin: 20px 0px;",
          "CC HTTPS://FEDERIC.OOO 👀"
        )
      })()
    </script>
  </body>
</html>
