---
import { LINKS, PROFILE } from "~/content"

import Github from "@svg/github.astro"

import HoverUl from "@c/HoverUl.astro"

const BRAND = "FEXAOP"

/** Must match the exact `id` in https://github.com/lugvitc/webring/blob/master/members.json */
const WEBRING_ID = "fexa"
const WEBRING = "https://webring-vit.vercel.app"

const BLOG_URL = "https://blog.pwnhub.in"

const links = [
  { label: "ABOUT", href: "/#about" },
  { label: "SERVICES", href: "/#services" },
  { label: "WORK", href: "/#work" },
  { label: "EXPERIENCE", href: "/#experience" },
  { label: "CONTACT", href: "/#contact" },
  {
    label: "BLOG",
    href: BLOG_URL,
    xsite: "to-blog",
  },
  {
    label: "GITHUB",
    href: LINKS.github,
    icon: "Github",
    target: "_blank",
  },
]
---

<nav
  data-module="nav"
  style="opacity: 0"
  class="px-gx py-gy pointer-events-none fixed top-0 z-10 flex w-full items-start justify-between"
>
  <a
    href="/"
    aria-label={`${BRAND} — back to homepage`}
    class="brand pointer-events-auto flex flex-col"
  >
    <span class="font-weird flex text-[1.6rem] leading-[0.9]" aria-hidden="true">
      {
        BRAND.split("").map((c, i) => (
          <span class="brand-letter inline-block" style={`--i:${i}`}>
            {c}
          </span>
        ))
      }
    </span>
    <span
      class="font-mono text-[.7em] tracking-widest text-gray-400 uppercase"
    >
      {PROFILE.role}
    </span>
  </a>

  <div class="flex flex-col items-end gap-3">
    <ul class="nav-links flex flex-col items-end gap-2 md:flex-row md:gap-4">
      {
        links.map(link => (
          <li class="relative text-[12px] leading-[1em]">
            <a
              href={link.href}
              class:list={[
                "pointer-events-auto tracking-wide",
                link.xsite && "xsite-blog-link",
              ]}
              target={link.target}
              data-xsite-nav={link.xsite}
              rel={link.xsite ? "noopener" : undefined}
            >
              {!link.icon && <HoverUl text={link.label} />}
              {link.icon === "Github" && (
                <figure data-hover="opacity">
                  <Github width="2rem" />
                  <figcaption class="sr-only">{link.label}</figcaption>
                </figure>
              )}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- VIT webring — id must match lugvitc/webring members.json -->
    <div
      class="webring pointer-events-auto flex items-stretch overflow-hidden rounded-full bg-black/70 shadow-[0_4px_24px_rgba(0,0,0,0.45)] backdrop-blur-md"
      aria-label="VIT community webring"
    >
      <a
        href={`${WEBRING}/redirect?from=${WEBRING_ID}&dir=prev`}
        class="webring-link"
        title="Previous site in the VIT webring"
      >
        <span aria-hidden="true">←</span>
        <span class="webring-label">prev</span>
      </a>
      <a
        href={`${WEBRING}/random`}
        class="webring-link webring-random"
        title="Random site in the VIT webring"
      >
        random
      </a>
      <a
        href={`${WEBRING}/redirect?from=${WEBRING_ID}&dir=next`}
        class="webring-link"
        title="Next site in the VIT webring"
      >
        <span class="webring-label">next</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</nav>

<style>
  .brand-letter {
    transform-origin: center bottom;
    will-change: transform;
  }

  /* playful staggered bounce on hover */
  .brand:hover .brand-letter {
    animation: brand-bounce 0.55s ease;
    animation-delay: calc(var(--i) * 0.045s);
  }

  @keyframes brand-bounce {
    0% {
      transform: translateY(0) rotate(0);
    }
    35% {
      transform: translateY(-0.32em) rotate(-8deg);
    }
    65% {
      transform: translateY(0.06em) rotate(4deg);
    }
    100% {
      transform: translateY(0) rotate(0);
    }
  }

  .webring-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35em;
    padding: 0.55rem 0.9rem;
    font-family: var(--font-mono), "Geist Mono", monospace;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    white-space: nowrap;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .webring-link:hover {
    background: #fff;
    color: #000;
  }

  .webring-random {
    border-inline: 1px solid rgba(255, 255, 255, 0.35);
    background: rgba(255, 255, 255, 0.08);
  }

  .xsite-blog-link {
    color: #ffe14f;
    font-weight: 700;
  }

  /* keep dense nav readable on small screens — hide mid links */
  @media (max-width: 767px) {
    .nav-links li:nth-child(2),
    .nav-links li:nth-child(4) {
      display: none;
    }

    .webring-link {
      padding: 0.5rem 0.7rem;
      font-size: 0.72rem;
    }

    .webring-label {
      display: none;
    }
  }
</style>
