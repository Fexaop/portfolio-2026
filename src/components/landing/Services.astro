---
import Section from "@c/Section.astro"
import { SERVICES } from "~/content"
---

<Section
  id="services"
  class="px-gx gap-xl relative flex flex-col items-center py-[6rem] md:py-[9rem]"
>
  <div class="md:w-grids-10 flex w-full flex-col gap-3 md:flex-row md:items-end md:justify-between">
    <div class="flex flex-col gap-3">
      <p class="font-mono text-[11px] tracking-[0.3em] text-gray-500 uppercase">
        What I do
      </p>
      <h2
        data-module="text"
        data-type="words"
        class="text-md md:text-xl max-w-[20ch] leading-[1.15em] font-semibold"
      >
        End-to-end systems — from API to cluster.
      </h2>
    </div>
    <p
      data-module="text"
      data-type="words"
      class="max-w-[36ch] text-gray-400 md:text-right"
    >
      Backend, platform, and cloud work that stays maintainable after launch —
      not just green in CI on day one.
    </p>
  </div>

  <div class="md:w-grids-10 grid w-full grid-cols-1 gap-4 sm:grid-cols-2">
    {
      SERVICES.map((s, i) => (
        <article
          data-module="alpha"
          data-delay={i * 0.08}
          class="content-card group flex flex-col gap-4 border border-white/15 bg-black/40 p-6 transition-colors duration-300 hover:border-white/35 hover:bg-black/55"
        >
          <div class="flex items-baseline justify-between gap-3">
            <span class="font-mono text-[11px] tracking-widest text-gray-500">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="text-base font-semibold tracking-tight md:text-lg">
              {s.title}
            </h3>
          </div>
          <p class="leading-[1.55em] text-gray-300">{s.copy}</p>
          <ul class="mt-auto flex flex-wrap gap-2 pt-2">
            {s.tags.map(tag => (
              <li class="rounded-full border border-white/20 px-2.5 py-0.5 font-mono text-[11px] tracking-wide text-gray-300">
                {tag}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</Section>
