---
import Section from "@c/Section.astro"
import { EXPERIENCE } from "~/content"
---

<Section
  id="experience"
  class="px-gx gap-xl relative flex flex-col items-center py-[6rem] md:py-[9rem]"
>
  <div class="md:w-grids-10 flex w-full flex-col gap-2">
    <p class="font-mono text-[11px] tracking-[0.3em] text-gray-500 uppercase">
      Experience
    </p>
    <h2
      data-module="text"
      data-type="words"
      class="text-md md:text-xl max-w-[22ch] leading-[1.15em] font-semibold"
    >
      How I spend the craft hours.
    </h2>
  </div>

  <ol class="md:w-grids-10 flex w-full flex-col">
    {
      EXPERIENCE.map((job, i) => (
        <li
          data-module="alpha"
          data-delay={i * 0.1}
          class="exp-row grid grid-cols-1 gap-4 border-t border-white/15 py-8 md:grid-cols-12 md:gap-6"
        >
          <div class="md:col-span-3">
            <p class="font-mono text-[12px] tracking-widest text-gray-400 uppercase">
              {job.period}
            </p>
          </div>
          <div class="md:col-span-4 flex flex-col gap-1">
            <h3 class="text-base font-semibold md:text-lg">{job.role}</h3>
            <p class="text-sm text-gray-400">{job.org}</p>
          </div>
          <ul class="md:col-span-5 flex flex-col gap-3 text-[14px] leading-[1.55em] text-gray-300">
            {job.points.map(p => (
              <li class="flex gap-3">
                <span class="mt-[0.55em] size-1 shrink-0 rounded-full bg-white/50" />
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</Section>
