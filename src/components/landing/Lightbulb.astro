---
import Svgg from "~/components/svg/Svgg.astro"
---

<!-- hand-drawn lightbulb that draws + drops from the top of the About section
     and retracts when you scroll away (see js/modules/bulb.ts). Glows on hover. -->
<div
  data-module="bulb"
  class="bulb absolute top-0 left-[78%] z-40 hidden w-[5.5rem] cursor-pointer md:block"
  aria-hidden="true"
>
  <Svgg name="bulb" class="bulb-svg h-auto w-full" />
  <span class="bulb-glow" aria-hidden="true"></span>
</div>

<style>
  .bulb {
    pointer-events: auto;
  }

  .bulb-svg {
    position: relative;
    z-index: 1;
    transition:
      filter 0.45s ease,
      stroke 0.45s ease;
  }

  /* warm ambient glow behind the glass of the bulb */
  .bulb-glow {
    position: absolute;
    top: 58%;
    left: 50%;
    z-index: 0;
    width: 4.2rem;
    height: 4.2rem;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      oklch(0.92 0.16 95 / 0.85) 0%,
      oklch(0.82 0.18 75 / 0.45) 38%,
      oklch(0.7 0.12 70 / 0) 72%
    );
    opacity: 0;
    transform: scale(0.55);
    transition:
      opacity 0.45s ease,
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
    filter: blur(2px);
  }

  .bulb:hover .bulb-glow {
    opacity: 1;
    transform: scale(1.15);
  }

  .bulb:hover .bulb-svg {
    filter:
      drop-shadow(0 0 6px oklch(0.92 0.18 95 / 0.95))
      drop-shadow(0 0 18px oklch(0.85 0.16 80 / 0.7))
      drop-shadow(0 0 36px oklch(0.78 0.14 70 / 0.45));
  }

  /* warm stroke when lit */
  .bulb:hover :global(svg) {
    stroke: oklch(0.95 0.08 95);
  }

  @media (prefers-reduced-motion: reduce) {
    .bulb-svg,
    .bulb-glow {
      transition: none;
    }
  }
</style>
