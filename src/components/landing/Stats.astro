---
import Section from "@c/Section.astro"
import { STATS, PROFILE } from "~/content"
---

<Section class="px-gx relative py-[3rem] md:py-[4rem]">
  <div
    class="md:w-grids-10 mx-auto grid w-full grid-cols-2 gap-px border border-white/15 bg-white/15 md:grid-cols-4"
  >
    {
      STATS.map((s, i) => (
        <div
          data-module="alpha"
          data-delay={i * 0.08}
          class="flex flex-col gap-2 bg-black px-4 py-6 md:px-6 md:py-8"
        >
          <p class="text-xl font-semibold tracking-tight md:text-2xl">
            {s.value}
          </p>
          <p class="font-mono text-[11px] tracking-widest text-gray-500 uppercase">
            {s.label}
          </p>
        </div>
      ))
    }
  </div>
  <p
    data-module="alpha"
    data-delay="0.35"
    class="md:w-grids-10 mx-auto mt-4 w-full font-mono text-[11px] tracking-widest text-gray-500 uppercase"
  >
    {PROFILE.location} · {PROFILE.availability}
  </p>
</Section>
