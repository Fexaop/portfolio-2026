---
/**
 * Site boot loader (circle).
 * IMPORTANT: hidden by default. Only shown when JS confirms a normal visit.
 * Arrivals from blog.pwnhub.in (?xsite=to-portfolio or cookie) never enable it.
 */
---

<div
  data-module="loader"
  data-loader-root
  class="site-loader absolute inset-0 z-50 flex items-center justify-center"
  hidden
  aria-hidden="true"
>
  <div class="absolute inset-0 flex items-center justify-center">
    <svg data-percentage viewBox="0 0 100 100" class="absolute w-[3em]">
      <circle
        cx="50"
        cy="50"
        r="45"
        fill="none"
        stroke="currentColor"
        class="opacity-30"
        stroke-width="2"></circle>
      <circle
        data-circle
        cx="50"
        cy="50"
        r="45"
        fill="none"
        stroke="currentColor"
        stroke-width="2"></circle>
    </svg>
  </div>
</div>

<style>
  .site-loader {
    pointer-events: none;
  }

  .site-loader[hidden] {
    display: none !important;
  }

  .site-loader:not([hidden]) [data-percentage] > circle:nth-child(2) {
    stroke-dasharray: 282.7433388230814;
    stroke-dashoffset: calc(282.7433388230814 * 1);
    transition: stroke-dashoffset 1.2s ease-in-out 0.5s;
  }

  /* Belt-and-suspenders when arriving from blog */
  :global(html.xsite-from-blog) .site-loader,
  :global(html.xsite-arrived) .site-loader,
  :global(html.xsite-from-blog) [data-module="loader"],
  :global(html.xsite-arrived) [data-module="loader"] {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
  }
</style>

<script>
  window.app = window.app || {}
  window.app.loader = window.app.loader || { circle: null, timeouts: [] }

  function fromBlog(): boolean {
    try {
      if (
        document.documentElement.classList.contains("xsite-from-blog") ||
        document.documentElement.classList.contains("xsite-arrived")
      ) {
        return true
      }
      // query
      const p = new URLSearchParams(location.search)
      const q = p.get("xsite")
      if (q === "to-portfolio" || q === "from-blog") return true
      // cookie Domain=.pwnhub.in
      if (/(?:^|;\s*)pwnhub_xsite=to-portfolio(?:;|$)/.test(document.cookie)) {
        return true
      }
    } catch {
      /* ignore */
    }
    return false
  }

  const root = document.querySelector("[data-loader-root]")

  if (fromBlog()) {
    // Never show — Pac-Man black veil covers boot
    root?.remove()
    window.app.loader.circle = null
    window.app.loader.timeouts = []
  } else if (root) {
    // Normal visit: enable loader UI
    root.hidden = false
    root.removeAttribute("aria-hidden")
    const circ = 282.7433388230814
    window.app.loader.circle = root.querySelectorAll("circle")[1]
    root.classList.add("init")

    let progress = 1
    const tick = () => {
      if (!window.app.loader.circle) return
      progress -= progress * 0.12 * (Math.random() + 0.05)
      window.app.loader.circle.style.strokeDashoffset = `${circ * progress}px`
      window.app.loader.timeouts.push(setTimeout(tick, 1800))
    }
    window.app.loader.timeouts.push(
      setTimeout(tick, 900 + Math.random() * 100),
    )
  }
</script>
