---
import Section from "@c/Section.astro"
import BouncySvg from "./BouncySvg.astro"
import Svgg from "~/components/svg/Svgg.astro"
import { SKILLS } from "~/content"

// hand-drawn doodle per skill category: code brackets, infinity loop, cloud, cylinder
const DOODLES = ["skill_backend", "skill_devops", "skill_cloud", "skill_db"]
---

<Section
  id="skills"
  class="px-gx gap-xl flex flex-col items-center py-[7rem] md:py-[10rem]"
>
  <div class="md:w-grids-10 flex w-full flex-col items-center gap-3 text-center">
    <div class="w-grids-4 md:w-grids-6">
      <BouncySvg name="skills" />
    </div>
    <p
      data-module="text"
      data-type="words"
      class="max-w-[48ch] text-gray-400"
    >
      The stack I reach for when reliability matters — services, platforms, and
      the data paths between them.
    </p>
  </div>

  <div
    class="md:w-grids-10 gap-lg grid w-full grid-cols-1 sm:grid-cols-2 md:grid-cols-4"
  >
    {
      SKILLS.map((cat, ci) => (
        <div
          data-module="alpha"
          data-delay={ci * 0.1}
          class="flex flex-col gap-4 rounded-sm border border-white/10 bg-black/30 p-5 transition-colors duration-300 hover:border-white/25"
        >
          <div data-module="draw" class="h-[3.5rem] w-[8rem]">
            <Svgg
              name={DOODLES[ci % DOODLES.length]}
              class="h-full w-auto"
            />
          </div>
          <h3 class="font-mono text-sm tracking-widest text-gray-400 uppercase">
            {cat.title}
          </h3>
          <ul class="flex flex-wrap gap-2">
            {cat.items.map(item => (
              <li class="rounded-full border border-white/20 px-3 py-1 text-[13px] tracking-wide">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
