---
import Svgg from "~/components/svg/Svgg.astro"
import { SLIDER_FOOD } from "../../../content"
const SLIDES = Array.from({ length: SLIDER_FOOD.length }, (_, i) => i)
---

<!-- Tall scroll track: scrolling through it scrubs the carousel "assembly".
     The inner block is sticky so it stays centred on screen while you scroll,
     and the WebGL cards fly in one by one and dock into the horizontal row. -->
<div
  style="--slide-w: clamp(18rem, 25vw, 30rem) "
  class="relative h-[300vh] w-full"
  data-module="fslider"
>
  <div
    class="gap-lg sticky top-0 flex h-screen w-full flex-col items-center justify-center overflow-clip"
  >
  <!-- slider track: the carousel is rendered in WebGL, so this flat row is
       hidden (opacity-0) and non-interactive — scroll drives everything now —
       but it stays in the layout so smooothy can measure item widths. -->
  <ul
    data-slider="wrapper"
    class="pointer-events-none ml-[calc((50vw-var(--slide-w)/2)-2rem)] flex text-[.8em] opacity-0 select-none"
    aria-hidden="true"
  >
    {
      SLIDER_FOOD.map((slide, i) => (
        <li
          data-name={slide.copy.name}
          data-desc={slide.copy.description}
          class:list={[
            "relative z-2 flex shrink-0 flex-col gap-2 px-[2rem]",
            i === 0 && "active",
          ]}
        >
          <div class="flex justify-between px-2">
            <p data-module="text" data-type="chars" class="tracking-wide">
              {String(i + 1).padStart(2, "0")}
            </p>
            <p
              data-module="alpha"
              data-delay=".18"
              class="font-mono text-sm tracking-widest uppercase"
            >
              Work
            </p>
          </div>

          <div
            data-gl
            class="relative z-10 flex aspect-[4/4.5] w-[var(--slide-w)] items-center justify-center md:aspect-[4/5.5]"
          >
            <!-- source svg for the WebGL ring icon (rasterized at runtime) -->
            <div class="pointer-events-none flex w-[58%] items-center justify-center">
              <Svgg name={slide.name} class="h-auto w-full" />
            </div>
          </div>

          <div class="flex justify-between gap-2 px-2">
            <h2
              data-module="text"
              data-type="chars"
              class="font-semibold tracking-tighter uppercase"
            >
              {slide.copy.name}
            </h2>
            <p
              data-module="text"
              data-type="chars"
              data-delay=".2"
              class="shrink-0 text-right"
            >
              {slide.copy.description}
            </p>
          </div>
        </li>
      ))
    }
  </ul>

  <!-- caption for the front-facing slide (text lives in the DOM since the ring
       itself is WebGL); updated on every settle -->
  <div
    class="pointer-events-none relative z-10 flex flex-col items-center gap-1 text-center"
  >
    <h2
      data-caption-name
      class="text-2xl font-semibold tracking-tight uppercase"
    >
    </h2>
    <p
      data-caption-desc
      class="font-mono text-sm tracking-widest uppercase opacity-70"
    >
    </p>
  </div>

  <!-- bottom ui: prev arrow | dots | next arrow, inline and centred -->
  <div data-no-cursor class="relative flex items-center justify-center gap-6">
    <ul data-slider="arrows" class="contents">
      <li data-module="alpha" data-delay=".5" class="order-1">
        <button class="pointer-events-auto" aria-label="previous slide">
          <div class="rotate-180">
            <Svgg name="arrow-r" />
          </div>
        </button>
      </li>
      <li data-module="alpha" data-delay=".7" class="order-3">
        <button class="pointer-events-auto" aria-label="next slide">
          <Svgg name="arrow-r" />
        </button>
      </li>
    </ul>

    <div data-slider="controls" class="order-2 flex flex-col gap-2">
      <ul class="flex gap-[1rem]">
        {
          SLIDES.map((slide, i) => (
            <li
              data-module="alpha"
              data-delay={1 + i * 0.2}
              class:list={i === 0 && "active"}
            >
              <button aria-label={`slide number ${slide}`}>
                <div class="aspect-square size-[.4rem] w-full rounded-full outline outline-white" />
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  </div>
</div>

<style>
  [data-slider="controls"] button {
    transition: background-color 0.3s ease-in-out;
  }

  [data-slider="controls"] .active button {
    background-color: white;
    pointer-events: none;
  }
</style>
