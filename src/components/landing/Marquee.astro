---
import { MARQUEE } from "~/content"

// Duplicate the list so the CSS loop can scroll seamlessly
const items = [...MARQUEE, ...MARQUEE]
---

<section
  class="marquee relative overflow-hidden border-y border-white/15 py-4 md:py-5"
  aria-label="Stack and domains"
>
  <div class="marquee-track flex w-max items-center gap-0">
    {
      items.map((item, i) => (
        <span class="flex items-center gap-6 px-6 md:gap-8 md:px-8">
          <span class="font-mono text-[12px] tracking-[0.25em] text-gray-300 uppercase md:text-[13px]">
            {item}
          </span>
          <span
            class="size-1 shrink-0 rounded-full bg-white/35"
            aria-hidden="true"
          />
        </span>
      ))
    }
  </div>
</section>

<style>
  .marquee-track {
    animation: marquee-scroll 48s linear infinite;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
