---
import BouncySvg from "./BouncySvg.astro"
import HoverUl from "@c/HoverUl.astro"
import Svgg from "~/components/svg/Svgg.astro"
import WasmTerminal from "~/components/WasmTerminal.astro"
import { PROFILE, LINKS } from "~/content"

const WEBRING_ID = "fexa"
---

<!-- Contact + terminal in one scroll: the hand-drawn terminal sits (small,
     rotated, shoved left) BEHIND the contact content. As you scroll, the
     contact content fades/scrolls away while the terminal stays pinned and
     reveals to full size, then runs `ssh terminal.shop`. -->
<section id="contact" data-module="terminal" class="relative h-[320vh] w-full">
  <!-- terminal: pinned behind the content, scrubs from small -> full -->
  <div
    class="sticky top-0 flex h-screen w-full items-center justify-center overflow-hidden"
  >
    <!-- scattered doodles framing the terminal -->
    <div
      data-module="draw"
      class="pointer-events-none absolute top-[10%] left-[4%] hidden w-[5.5rem] opacity-70 md:block"
      aria-hidden="true"
    >
      <Svgg name="term_ssh" class="h-auto w-full" />
    </div>
    <div
      data-module="draw"
      class="pointer-events-none absolute bottom-[14%] right-[4%] hidden w-[8rem] opacity-65 md:block"
      aria-hidden="true"
    >
      <Svgg name="term_handshake" class="h-auto w-full" />
    </div>
    <div
      data-module="draw"
      class="pointer-events-none absolute bottom-[18%] left-[6%] hidden w-[7rem] opacity-60 lg:block"
      aria-hidden="true"
    >
      <Svgg name="term_pulse" class="h-auto w-full" />
    </div>

    <div
      data-term="stage"
      class="relative aspect-[820/540] w-[88vw] max-w-[60rem] will-change-transform"
      style="transform: translateX(-50%) rotate(45deg) scale(0.5); transform-origin: center"
    >
      <div class="absolute inset-0">
        <Svgg name="terminal-frame" class="h-full w-full" />
      </div>
      <!-- WASM TUI portfolio — no SSH proxy needed -->
      <div
        data-term="screen"
        class="absolute top-[22%] right-[6%] bottom-[7%] left-[6%] overflow-hidden"
      >
        <WasmTerminal />
      </div>
    </div>
  </div>

  <!-- contact content: the first screen, in front of the terminal; fades and
       scrolls away as you go down -->
  <div
    data-term="content"
    class="px-gx gap-lg absolute inset-x-0 top-0 z-10 flex h-screen flex-col items-center justify-center text-center"
  >
    <div class="w-grids-5 md:w-grids-8 md:pb-md">
      <BouncySvg name="contact" />
    </div>

    <p
      data-module="alpha"
      class="font-mono text-[11px] tracking-[0.3em] text-gray-500 uppercase"
    >
      {PROFILE.availability}
    </p>

    <p
      data-module="text"
      data-type="words"
      class="text-md max-w-[44ch] leading-[1.4em] font-semibold text-balance"
    >
      Open to backend &amp; DevOps roles and freelance work — let&rsquo;s build
      something reliable.
    </p>

    <p
      data-module="text"
      data-type="words"
      class="max-w-[40ch] text-[14px] leading-[1.55em] text-gray-400"
    >
      Prefer a green terminal to a form? Scroll for the interactive TUI — or
      reach out the old-fashioned way.
    </p>

    <ul class="gap-lg text-lg flex flex-wrap items-center justify-center font-semibold">
      <li data-hover="opacity">
        <a href={LINKS.github} target="_blank" rel="noopener">
          <HoverUl text="GitHub" />
        </a>
      </li>
      <li data-hover="opacity">
        <a href={LINKS.email}>
          <HoverUl text="Email" />
        </a>
      </li>
      <li data-hover="opacity">
        <a href={LINKS.email}>
          <HoverUl text={PROFILE.email} />
        </a>
      </li>
    </ul>

    <!-- VIT webring — id must match members.json exactly -->
    <nav
      class="pt-xl flex flex-wrap items-center justify-center gap-x-4 gap-y-2 font-mono text-[11px] tracking-wide text-gray-400"
      aria-label="VIT community webring"
    >
      <a
        href={`https://webring-vit.vercel.app/redirect?from=${WEBRING_ID}&dir=prev`}
        class="transition-colors hover:text-white"
      >
        ← previous site
      </a>
      <a
        href="https://webring-vit.vercel.app/random"
        class="transition-colors hover:text-white"
      >
        random site
      </a>
      <a
        href={`https://webring-vit.vercel.app/redirect?from=${WEBRING_ID}&dir=next`}
        class="transition-colors hover:text-white"
      >
        next site →
      </a>
    </nav>

    <p class="pt-md font-mono text-sm tracking-widest text-gray-500 uppercase">
      © 2026 {PROFILE.name} · {PROFILE.location}
    </p>
  </div>
</section>
