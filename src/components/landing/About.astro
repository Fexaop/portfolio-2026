---
import Section from "@c/Section.astro"
import BouncySvg from "./BouncySvg.astro"
import Lightbulb from "./Lightbulb.astro"
import Svgg from "~/components/svg/Svgg.astro"
import { ABOUT, PROFILE } from "~/content"
---

<Section
  id="about"
  class="px-gx md:gap-lg relative flex flex-col items-center overflow-hidden py-[7rem] md:py-[10rem]"
>
  <Lightbulb />

  <!-- scattered hand-drawn doodles that draw themselves on scroll-in -->
  <div
    data-module="draw"
    class="pointer-events-none absolute top-[24%] left-[5%] hidden w-[7rem] opacity-80 md:block"
    aria-hidden="true"
  >
    <Svgg name="set_drag" class="h-auto w-full" />
  </div>
  <div
    data-module="draw"
    class="pointer-events-none absolute right-[6%] bottom-[20%] hidden w-[8rem] opacity-80 md:block"
    aria-hidden="true"
  >
    <Svgg name="set_extensible" class="h-auto w-full" />
  </div>
  <div
    data-module="draw"
    class="pointer-events-none absolute bottom-[26%] left-[9%] hidden w-[5rem] opacity-70 lg:block"
    aria-hidden="true"
  >
    <Svgg name="wave" class="h-auto w-full" />
  </div>

  <div class="w-grids-4 md:w-grids-5 md:pb-lg">
    <BouncySvg name="about" />
  </div>

  <div class="md:w-grids-8 gap-md flex flex-col items-center text-center">
    <p
      data-module="alpha"
      class="font-mono text-[11px] tracking-[0.3em] text-gray-500 uppercase"
    >
      {PROFILE.handle} · {PROFILE.location}
    </p>
    <h2
      data-module="text"
      data-type="words"
      class="text-md md:text-lg leading-[1.2em] font-semibold text-balance"
    >
      {ABOUT.lead}
    </h2>
    <p
      data-module="text"
      data-type="words"
      class="max-w-[62ch] leading-[1.6em] text-gray-300"
    >
      {ABOUT.body}
    </p>
    <p
      data-module="text"
      data-type="words"
      class="max-w-[58ch] leading-[1.6em] text-gray-400"
    >
      {ABOUT.body2}
    </p>
  </div>

  <div
    class="md:w-grids-10 mt-xl grid w-full grid-cols-1 gap-px border border-white/15 bg-white/15 sm:grid-cols-3"
  >
    {
      ABOUT.focus.map((f, i) => (
        <div
          data-module="alpha"
          data-delay={i * 0.1}
          class="flex flex-col gap-2 bg-black px-5 py-6 text-left md:px-6 md:py-8"
        >
          <p class="font-mono text-[11px] tracking-widest text-gray-500 uppercase">
            {f.label}
          </p>
          <p class="text-[14px] leading-[1.5em] text-gray-300">{f.value}</p>
        </div>
      ))
    }
  </div>
</Section>
