---
import Section from "@c/Section.astro"
import { PROJECT_DETAILS, LINKS } from "~/content"
---

<Section
  id="projects"
  class="px-gx gap-xl relative flex flex-col items-center py-[5rem] md:py-[7rem]"
>
  <div
    class="md:w-grids-10 flex w-full flex-col gap-3 md:flex-row md:items-end md:justify-between"
  >
    <div class="flex flex-col gap-2">
      <p class="font-mono text-[11px] tracking-[0.3em] text-gray-500 uppercase">
        Archive
      </p>
      <h2
        data-module="text"
        data-type="words"
        class="text-md md:text-xl max-w-[22ch] leading-[1.15em] font-semibold"
      >
        Projects with the context filled in.
      </h2>
      <p
        data-module="text"
        data-type="words"
        class="mt-2 max-w-[42ch] text-[14px] leading-[1.5em] text-gray-400"
      >
        Backend platforms, Linux tooling, auth libs, and the experiments that
        never stayed private.
      </p>
    </div>
    <a
      href={LINKS.github}
      target="_blank"
      rel="noopener"
      data-module="alpha"
      data-delay="0.2"
      class="font-mono text-[12px] tracking-widest text-gray-400 uppercase transition-colors hover:text-white"
    >
      All on GitHub ↗
    </a>
  </div>

  <div class="md:w-grids-10 grid w-full grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {
      PROJECT_DETAILS.map((p, i) => (
        <a
          href={p.url}
          target="_blank"
          rel="noopener"
          data-module="alpha"
          data-delay={(i % 6) * 0.06}
          class="project-card group flex flex-col gap-3 border border-white/15 bg-black/50 p-5 transition-all duration-300 hover:border-white/40 hover:bg-black/70"
        >
          <div class="flex items-start justify-between gap-2">
            <h3 class="text-base font-semibold tracking-tight group-hover:underline group-hover:underline-offset-4">
              {p.name}
            </h3>
            <span class="shrink-0 rounded-full border border-white/20 px-2 py-0.5 font-mono text-[10px] tracking-wider text-gray-400 uppercase">
              {p.status}
            </span>
          </div>
          <p class="text-[13px] leading-[1.5em] text-gray-300">{p.summary}</p>
          <div class="mt-auto flex items-center justify-between gap-2 pt-3 font-mono text-[11px] tracking-wide text-gray-500 uppercase">
            <span>{p.stack}</span>
            <span>{p.year}</span>
          </div>
        </a>
      ))
    }
  </div>
</Section>

<style>
  .project-card {
    min-height: 11rem;
  }
</style>
